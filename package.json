{
  "name": "lattice-json-workbench",
  "private": true,
  "version": "1.0.0-rc.10",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run notices && tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src tests e2e scripts",
    "bench": "tsx scripts/benchmark.ts",
    "web:dev": "vite --host 127.0.0.1",
    "web:build": "npm run notices && tsc -b && vite build --base=./",
    "web:preview": "vite preview --host 127.0.0.1",
    "offline:build": "npm run web:build && node scripts/build-offline.mjs",
    "pwa:build": "npm run web:build && node scripts/build-pwa.mjs",
    "test:browser": "playwright test",
    "bench:browser": "node scripts/benchmark-browser.mjs",
    "notices": "node scripts/build-notices.mjs",
    "release:checksums": "node scripts/build-checksums.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "diff": "9.0.0",
    "jsonc-parser": "3.3.1",
    "react": "19.3.1",
    "react-data-grid": "7.0.0-beta.64",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fast-check": "4.10.2",
    "oxlint": "1.94.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "license": "0BSD"
}
